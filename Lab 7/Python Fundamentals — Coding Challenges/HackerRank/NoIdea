def happiness(arr, A, B):
    score = 0
    for x in arr:
        if x in A:
            score += 1
        elif x in B:
            score -= 1
    return score


n, m = map(int, input().split())
arr = list(map(int, input().split()))
A = set(map(int, input().split()))
B = set(map(int, input().split()))

print(happiness(arr, A, B))
